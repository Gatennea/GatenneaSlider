# ===== 一次性探针 / 临时输出（2026-10-31 加）=====
# 起因：工作区 untracked 噪音 200+，`git status` 被淹没到无法审阅。
# 规则：archive 下的一次性脚本与其产物不进版本库（scratch_* / retained 同理）。
# 文件都还在磁盘上（文档里按路径引用依然有效），只是不进版本库。
archive/_*
archive/scratch_*/
# 直接放在 archive/ 根下的 scratch_*.py / .png 也该忽略：原规则只匹配目录，
# 探针脚本反倒漏进工作区（2026-11-07 补）
archive/scratch_*
archive/retained/
out_*.txt

# ===== 背景樂母帶（2026-11-07 加）=====
# assets/audio/music/ 只收壓縮格式（bgm.ogg / *.mp3）；原始 wav 體積大、zip 壓不動，
# 留在本機當母帶即可，不進版本庫、也不進安裝包（spec 的 _collect_assets 一併跳過）。
# ⚠️ 只管 music/：sound/ 下的 slide*.wav 是短音效，必須照常入庫。
assets/audio/music/*.wav

# ===== experiments/：**脚本全入库**（2026-10-31 用户拍板），只忽略产物 =====
# 命名：script_* = 独立脚本（不被 import）；reuse_* = 既能独立跑又被 import；
#       无前缀 = 库（被 import、不能独立跑）。
# 已忽略的大产物目录见上：experiments/out/ disks/ results/ math_repro/full_A/
